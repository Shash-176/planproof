# Copy to .env.local for local development. Never commit .env.local.
# On Vercel, set these under Project → Settings → Environment Variables.
#
# AI analysis is optional: without a key, PlanProof still verifies pasted SQL.

# Default provider: Groq (free plan). Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: ordered fallback chain "provider:model,provider:model".
# Default when unset: groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b
# AI_CHAIN=

# Optional presets (read docs/AI-PROVIDER.md before using them on a public site)
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Any OpenAI-compatible endpoint, e.g. a local Ollama:
# AI_CUSTOM_BASE_URL=http://localhost:11434/v1
# AI_CUSTOM_API_KEY=ollama
